    {
      "id": "bc1f49db5c1d4f838fe739c5afa5e32a",
      "name": "Get WB Reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "url": "https://feedbacks1.wb.ru/feedbacks/v1/115004617",
        "options": {
          "headers": {
            "User-Agent": "Mozilla/5.0"
          },
          "response": {
            "responseFormat": "json"
          }
        },
        "sendQuery": false,
        "authentication": "none",
        "method": "GET"
      }
    },
    {
      "id": "ed1af4422a7e4c96956240277e045797",
      "name": "Extract 100",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "jsCode": "var fb = $input.first().json.feedbacks || [];\nvar out = [];\nfor (var i = 0; i < fb.length && out.length < 100; i++) {\n  var x = fb[i];\n  var tx = String(x.text || x.pros || x.cons || \"\").trim();\n  if (!tx) continue;\n  out.push({\n    text: tx,\n    rating: x.productValuation || 0,\n    date: x.createdDate || \"\",\n    author: (x.wbUserDetails && x.wbUserDetails.name) || \"\"\n  });\n}\nreturn out;\n"
      }
    },
    {
      "id": "cb4e87ad3ae04423a256a935ebfdbe95",
      "name": "Build CSV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "jsCode": "var items = $input.all();\nvar src = $(\"Extract 100\").all();\nvar rows = [\"text,rating,category,sentiment,date\"];\nvar cc = { p: 0, z: 0, v: 0 };\nvar sc = { pos: 0, neg: 0, neu: 0 };\nvar comp = [];\nfunction q(s) { return '\"' + String(s == null ? \"\" : s).replace(/\"/g, '\"\"') + '\"'; }\nfor (var idx = 0; idx < items.length; idx++) {\n  var j = items[idx].json;\n  var orig = (src[idx] && src[idx].json) || {};\n  var content = \"\";\n  if (j.choices && j.choices[0] && j.choices[0].message) content = String(j.choices[0].message.content || \"\");\n  var parts = content.split(\"|\");\n  var cat = (parts[0] || \"vopros\").toLowerCase().trim();\n  var sent = (parts[1] || \"neutral\").toLowerCase().trim();\n  if (cat.indexOf(\"pohvala\") >= 0) cc.p++; else if (cat.indexOf(\"zhaloba\") >= 0) cc.z++; else cc.v++;\n  if (sent.indexOf(\"positive\") >= 0) sc.pos++; else if (sent.indexOf(\"negative\") >= 0) sc.neg++; else sc.neu++;\n  var tx = String(orig.text || \"\");\n  rows.push(q(tx) + \",\" + (orig.rating || 0) + \",\" + q(cat) + \",\" + q(sent) + \",\" + q(orig.date || \"\"));\n  if (cat.indexOf(\"zhaloba\") >= 0 && tx.length > 10) comp.push(tx.substring(0, 100));\n}\nreturn [{ json: {\n  csv: rows.join(\"\\n\"),\n  summary: {\n    total: items.length,\n    categories: { pohvala: cc.p, zhaloba: cc.z, vopros: cc.v },\n    sentiments: { positive: sc.pos, negative: sc.neg, neutral: sc.neu },\n    top3_complaints: comp.slice(0, 3)\n  }\n} }];\n"
      }
    },
    {
      "id": "c23acd7c71c04ffe8b2535eb9deb8815",
      "name": "End",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1300,
        300
      ],
      "parameters": {}
    },
    {
      "id": "fec87366e82a42a7b517cae6032d37f4",
      "name": "Telegram",
      "webhookId": "0f81be2d-3e74-4cdb-a8f3-40b9f26bbacd",
      "disabled": true,
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1300,
        -50
      ],
      "parameters": {
