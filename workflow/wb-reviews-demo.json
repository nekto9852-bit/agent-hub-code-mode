      ],
      "parameters": {
        "url": "https://polza.ai/api/v1/chat/completions",
        "method": "POST",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "model": "deepseek/deepseek-v4-flash",
          "messages": [
            {
              "role": "system",
              "content": "Output ONLY: category|sentiment, category=pohvala/zhaloba/vopros, sentiment=positive/negative/neutral"
            },
            {
              "role": "user",
              "content": "Classify: {{ $json.text }}"
            }
          ],
          "max_tokens": 30,
          "temperature": 0.1
        },
        "responseFormat": "json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{$env.POLZA_API_KEY}}"
            }
          ]
        }
      }
    },
    {
